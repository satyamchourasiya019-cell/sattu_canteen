# ------------------------------------------------------------------
# Copy this file to `.env` (local) and configure the same values in
# Vercel Project Settings -> Environment Variables for production.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Firebase web app config (Project settings -> General -> Your apps)
# These identify your Firebase project. Real protection comes from
# Firebase Authentication + Firestore Security Rules, not from hiding
# these values. Still, keep them in env vars, not hardcoded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: default canteen name used on first-run seeding
VITE_CANTEEN_NAME=Company Canteen
